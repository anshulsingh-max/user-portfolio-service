pipeline {
    agent any

    environment {
        CURR_VER = "${currentBuild.number}"
        PRE_VER = "${currentBuild.previousBuild.getNumber()}"
        AWS_PROFILE = "intraday-super"
        SERVICE_NAME = "user-portfolio-service"
        SERVICE_NAME_WORKER = "user-portfolio-service-worker"
        SERVICE_NAME_BEAT = "user-portfolio-service-beat"
        SERVICE_NAME_NGINX = "user-portfolio-service-nginx"
        POSTGRES_USER = "myuser"
        POSTGRES_PASSWORD = "mypassword"
        POSTGRES_DB = "mydatabase"
    }

    stages {
 
        stage('Docker Build') {
            when {
                expression { currentBuild.resultIsBetterOrEqualTo('SUCCESS') }
            }
            steps {
                sh "sudo docker build -t 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME}-prod-${env.CURR_VER} -f Dockerfile ."
                sh "sudo docker build -t 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_BEAT}-prod-${env.CURR_VER} -f Dockerfilebeat ."
                sh "sudo docker build -t 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_WORKER}-prod-${env.CURR_VER} -f Dockerfileworker ."
                sh "sudo docker build -t 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_NGINX}-prod-${env.CURR_VER} -f ./configurations/nginx/Dockerfile ."
            }
        }

        stage('Clean Images') {
            steps {
                sh "echo \$(sudo docker rmi 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME}-prod-${env.PRE_VER})"
                sh "echo \$(sudo docker rmi 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_BEAT}-prod-${env.PRE_VER})"
                sh "echo \$(sudo docker rmi 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_WORKER}-prod-${env.PRE_VER})"
                sh "echo \$(sudo docker rmi 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_NGINX}-prod-${env.PRE_VER})"
            }
        }

        stage('Push Image') {
            steps {
                sh "sudo aws ecr get-login-password --region ap-south-1 --profile intraday-super | sudo docker login --username AWS --password-stdin 637423188463.dkr.ecr.ap-south-1.amazonaws.com"
                sh "sudo docker push 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME}-prod-${env.CURR_VER}"
                sh "sudo docker push 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_BEAT}-prod-${env.CURR_VER}"
                sh "sudo docker push 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_NGINX}-prod-${env.CURR_VER}"
                sh "sudo docker push 637423188463.dkr.ecr.ap-south-1.amazonaws.com/youtrade-prod:${SERVICE_NAME_WORKER}-prod-${env.CURR_VER}"
            }
        }

        stage('Run Image') {
            steps {
                sshagent(['crypto-dev']) {
                    script {
                        sh "aws eks update-kubeconfig --region ap-south-1 --name youtrade-prod --alias youtrade-prod"
                        sh "envsubst < ${WORKSPACE}/user-portfolio-service-prod-new.yaml | kubectl apply -f -" 
                    }
                }
            }
        }
    }
}
