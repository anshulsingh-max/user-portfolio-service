pipeline {
    agent any

    environment {
        CURR_VER = "${currentBuild.number}"
        PRE_VER  = "${currentBuild.previousBuild.getNumber()}"
    }


    stages {

      stage('Docker Build'){
            steps {
                sh "sudo docker build -t 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.CURR_VER} -f ./configurations/nginx/Dockerfile ."
                sh "sudo docker build -t 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.CURR_VER} -f Dockerfile ."
                sh "sudo docker build -t 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-worker${env.CURR_VER} -f Dockerfileworker ."

            }
       }
       stage('Clean Images') {
            steps {
                sh "echo \$(sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.PRE_VER})"
                sh "echo \$(sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.PRE_VER})"
                sh "echo \$(sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-worker${env.PRE_VER})"
            }
        }
        stage('pushImage'){
            steps {
            sh "sudo aws ecr get-login-password --region eu-west-2 --profile crypto-super | sudo docker login --username AWS --password-stdin 240261184178.dkr.ecr.eu-west-2.amazonaws.com"
            sh "sudo docker push 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.CURR_VER}"
            sh "sudo docker push 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.CURR_VER}"
            sh "sudo docker push 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-worker${env.CURR_VER}"
       }
    }

        stage('Run Image'){
            steps {
				sshagent(['crypto-dev']) {
					sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rm -vf  user-portfolio-service || true "
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rm -vf  user-portfolio-service-nginx || true "
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rm -vf  user-portfolio-service-worker || true "
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.PRE_VER} || true "
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.PRE_VER} || true "
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker rmi 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-worker${env.PRE_VER} || true "
					sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 \"aws ecr get-login-password --region eu-west-2 | sudo docker login --username AWS --password-stdin 240261184178.dkr.ecr.eu-west-2.amazonaws.com && sudo docker pull 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.CURR_VER} && sudo docker pull 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.CURR_VER} \" "			
					sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker run -d --restart=unless-stopped --network prometheus --name user-portfolio-service -p 52036:8000 --env-file /home/ubuntu/user-portfolio-service 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-${env.CURR_VER}"	
    				sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker run -d --restart=unless-stopped --network prometheus --name user-portfolio-service-nginx -p 52037:80 --env-file /home/ubuntu/user-portfolio-service 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-nginx${env.CURR_VER}"
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@10.202.1.47 sudo docker run -d --restart=unless-stopped --network prometheus --name user-portfolio-service-worker --env-file /home/ubuntu/user-portfolio-service 240261184178.dkr.ecr.eu-west-2.amazonaws.com/intraday-dev:user-portfolio-service-worker${env.CURR_VER}"
                    }
   	    }
    }
    }
    }